#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST_FILE="$ROOT_DIR/rails/app/lib/temples/manifest.yml"

if [ ! -f "$MANIFEST_FILE" ]; then
  echo "Manifest not found at $MANIFEST_FILE" >&2
  exit 1
fi

# `ruby <<HEREDOC "$FILE"` hands ruby the FILE as its script and the heredoc as
# ignored stdin, so this read the manifest as Ruby and produced nothing. Inside
# mapfile that is silent: an empty array, a loop that never runs, and a deploy
# that reports success having deployed no temple. `-` takes the script from
# stdin and leaves the filename as ARGV.
mapfile -t TEMPLE_SLUGS < <(ruby - "$MANIFEST_FILE" <<'RUBY'
require "yaml"
file = ARGV.first
data = YAML.safe_load_file(file).fetch("temples")
data.each { |entry| puts entry.fetch("slug") }
RUBY
)

if [ "${#TEMPLE_SLUGS[@]}" -eq 0 ]; then
  echo "No temples defined in manifest." >&2
  exit 1
fi

for slug in "${TEMPLE_SLUGS[@]}"; do
  echo "=== Deploying Vue build for ${slug} ==="
  "$ROOT_DIR/bin/deploy_vue" "$slug"
done
