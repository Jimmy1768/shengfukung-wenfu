#!/usr/bin/env bash
#
# Run a Rails command against this checkout's deployment environment.
#
# There was previously no supported way to do this. The gap got filled by
# hand-assembling `RAILS_ENV=staging PGDATABASE=... bin/rails ...` on the
# command line, which is invented protocol: it works until the day one of the
# values is wrong or forgotten, and then it runs against production.
#
# This wrapper carries no value. It sources the shared environment file and then
# this checkout's instance.env, in that order, and execs. Under the environment
# partition no variable appears in both files, so the order is defence rather
# than precedence -- there is nothing to override.
#
# It exports exactly one thing, and that thing is not a value: a declaration of
# which environment it believes it is running. The guard holds it to that. See
# the block above the export below for why declaring beats copying.
#
# Deliberately unlike sourcegrid-labs/bin/staging, which this mirrors in shape:
# that script sources its env files and then exports eighteen explicit staging
# overrides. Those overrides are the precedence problem this repository is
# removing, so the skeleton is reused and the override block is not.
#
# If the runtime/secrets split (plan §6.3) is adopted, the one line that changes
# is SHARED_ENV_FILE below: it becomes two files, sourced in order. Nothing else
# here depends on the shared environment living in a single file.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RAILS_DIR="$ROOT_DIR/rails"

SHARED_ENV_FILE="${WENFU_SHARED_ENV_FILE:-/etc/default/shengfukung-wenfu-env}"
INSTANCE_ENV_FILE="${WENFU_INSTANCE_ENV_FILE:-$ROOT_DIR/instance.env}"

# Must match DeploymentIdentity::OVERRIDE_VARIABLE. The guard honours this name
# wherever it comes from; this script refuses to let it come from a file.
OVERRIDE_VARIABLE="WENFU_EXPECTED_DATABASE"

usage() {
  cat <<'USAGE'
Usage: bin/staging <command> [args...]

Examples:
  bin/staging rails c
  bin/staging rails db:migrate
  bin/staging rails runner 'puts Rails.env'

Sources the shared environment file and then this checkout's instance.env,
in that order. It copies no value. It declares one thing -- that this is
staging -- and the guard refuses if the database that actually resolves
disagrees with that claim.

So run it from the staging checkout. Run anywhere else it refuses, rather
than quietly handing you whatever environment that checkout happens to
hold: the name you typed is treated as a decision, not a label.

Override the file locations for testing with WENFU_SHARED_ENV_FILE and
WENFU_INSTANCE_ENV_FILE.
USAGE
}

require_readable_env_file() {
  local file="$1"
  local label="$2"
  local remedy="$3"

  if [[ ! -r "$file" ]]; then
    echo "bin/staging: cannot read the ${label} environment file:" >&2
    echo "  ${file}" >&2
    echo "${remedy}" >&2
    exit 1
  fi
}

# WENFU_EXPECTED_DATABASE acknowledges a deliberate, one-off exception on a
# single invocation: the guard still requires the resolved name to match it
# exactly, so it states a different expected answer rather than skipping the
# comparison. In a file it stops being one-off. Every boot from then on passes a
# guard that has been quietly disarmed, and the WARN line that was supposed to
# make it noticeable is printed so often it stops being read.
#
# That is the one way a convention like this actually rots: someone adds it to
# an env file to silence the warning. So refuse rather than source it.
#
# The limit, stated because this must not read as more than it is: a systemd
# unit, a shell export or a parent process can still set this name and the guard
# will honour it. This checks the two files the wrapper itself sources, which is
# where the rot starts, not everywhere the value can come from.
refuse_override_in_env_file() {
  local file="$1"
  local label="$2"

  if grep -Eq "^[[:space:]]*(export[[:space:]]+)?${OVERRIDE_VARIABLE}[[:space:]]*=" "$file"; then
    echo "bin/staging: ${OVERRIDE_VARIABLE} is set in the ${label} environment file:" >&2
    echo "  ${file}" >&2
    echo "${OVERRIDE_VARIABLE} acknowledges a one-off exception on a single command." >&2
    echo "In an env file it disarms the deployment guard on every boot instead." >&2
    echo "Remove the line, and set it inline on the one invocation that needs it:" >&2
    echo "  ${OVERRIDE_VARIABLE}=<exact database name> bin/staging rails c" >&2
    exit 1
  fi
}

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

# Refusing is the correct outcome, not an inconvenience. Sourcing whichever of
# the two files happens to exist is how a command ends up running with half an
# environment, and half an environment is how it ends up on the wrong database.
# On a development machine neither file exists, so refusing is also the normal
# local behaviour of this script.
require_readable_env_file "$SHARED_ENV_FILE" "shared" \
  "It is root-owned and readable by the deploy user on the droplet. This
script is for use on a deployment host; on a development machine use
bin/rails directly. Override the path with WENFU_SHARED_ENV_FILE."

require_readable_env_file "$INSTANCE_ENV_FILE" "instance" \
  "Every checkout needs its own instance.env holding the five values that
differ per deployment. Create it from the matching example:
  cp ops/env/template.instance.staging.env ${ROOT_DIR}/instance.env
Override the path with WENFU_INSTANCE_ENV_FILE."

refuse_override_in_env_file "$SHARED_ENV_FILE" "shared"
refuse_override_in_env_file "$INSTANCE_ENV_FILE" "instance"

set -a
# shellcheck disable=SC1090
source "$SHARED_ENV_FILE"
# shellcheck disable=SC1090
source "$INSTANCE_ENV_FILE"
set +a

# One export, and it is a claim rather than a value.
#
# sourcegrid-labs/bin/staging has eighteen `export` lines at exactly this point
# -- RAILS_ENV, PUMA_PORT, DATABASE_URL, PGHOST and the rest -- each with a
# `${SOURCEGRID_STAGING_*:-default}` fallback. Do not restore them here by
# analogy. Those exports are a third source of truth layered on top of two env
# files, which is the precedence problem this repository removed: staging used
# to correct the shared environment file with a systemd ExecStart prefix, and
# losing that prefix silently gave staging production's database.
#
# Copying a value here would also protect only half of what runs. The console
# would read the wrapper's copy and the systemd service would read the instance
# file, and when the two disagreed nothing could say which was right. Under the
# partition the instance file already carries every value that differs per
# deployment, so an export of a value could only restate one or contradict it.
# If a value seems to be missing, it belongs in this checkout's instance.env.
#
# What the wrapper does contribute is intent. Its name is a decision -- someone
# typed `bin/staging` because they meant staging -- and that decision is
# otherwise thrown away at exec. Exporting it lets the guard compare the claim
# against the database actually resolved, and refuse a claim that turns out to
# be false, whether or not a human is watching. Declaring is not copying: this
# says which environment, never which database.
export WENFU_DECLARED_ENVIRONMENT="staging"

cd "$RAILS_DIR"

if [[ "$1" == "rails" ]]; then
  shift
  exec bundle exec rails "$@"
fi

exec bundle exec "$@"
