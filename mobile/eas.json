{
  "cli": {
    "version": ">= 11.0.2",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "node": "24.21.0",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "BUILD_MODE": "development"
      }
    },
    "testflight": {
      "node": "24.21.0",
      "distribution": "store",
      "ios": { "buildConfiguration": "Release" },
      "channel": "testflight",
      "env": {
        "BUILD_MODE": "testflight",
        "TEMPLEMATE_CLIENT_ENVIRONMENT": "testflight",
        "TEMPLEMATE_EAS_UPDATE_CHANNEL": "testflight",
        "TEMPLEMATE_PUBLIC_API_ORIGIN": "https://shengfukung.com.tw"
      }
    },
    "production": {
      "node": "24.21.0",
      "distribution": "store",
      "ios": { "buildConfiguration": "Release" },
      "channel": "production",
      "env": {
        "BUILD_MODE": "production",
        "TEMPLEMATE_CLIENT_ENVIRONMENT": "production",
        "TEMPLEMATE_EAS_UPDATE_CHANNEL": "production",
        "TEMPLEMATE_PUBLIC_API_ORIGIN": "https://shengfukung.com.tw"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6802948571"
      }
    }
  }
}
