source "https://rubygems.org"

ruby "3.2.3"

# ==== Core framework =========================================================
gem "rails", "~> 7.1.5", ">= 7.1.5.1"
gem "puma", ">= 5.0"
gem "pg", "~> 1.5"
gem "bootsnap", require: false
gem "tzinfo-data", platforms: %i[ windows jruby ]
gem "rack-cors"
gem "bcrypt", "~> 3.1"

# ==== Authentication / identity =============================================
gem "omniauth"
gem "omniauth-rails_csrf_protection"
gem "omniauth-google-oauth2"
gem "omniauth-facebook"
gem "omniauth-apple"

# ==== Storage & external services ===========================================
gem "aws-sdk-s3", "~> 1.147"
gem "httparty"
gem "googleauth"
gem "stripe", "~> 17.0"

# ==== Background jobs / caching =============================================
gem "redis", ">= 5.0"
gem "sidekiq", "~> 7.2"

# Renders the temple connection QR the TempleMate app scans (account portal).
gem "rqrcode", "~> 3.2"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ]
end

group :development do
  # Speed up commands on slow machines / big apps [https://github.com/rails/spring]
  # gem "spring"
end

# Must include :test. It was :development only, so .env.test was never loaded
# and its PGDATABASE_TEST pin was inert -- the suite fell through to
# config/database.yml's default and ran against another project's test database
# as another project's Postgres role. Confirmed 2026-09-07:
# db=golden_template_test user=golden_template_dev.
group :development, :test do
  # Load .env files (e.g., .env.development, .env.test) into ENV.
  gem "dotenv-rails"
end
