<% form_action = gallery_entry.persisted? ? admin_gallery_entry_path(gallery_entry) : admin_gallery_entries_path %>
<%= form_with model: gallery_entry, url: form_action, scope: :temple_gallery_entry, class: "form-stack" do |form| %>
  <% if gallery_entry.errors.any? %>
    <div class="inline-validation" data-inline-validation>
      <strong><%= t("admin.gallery_entries.form.errors", count: gallery_entry.errors.count) %></strong>
      <ul>
        <% gallery_entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, t("admin.gallery_entries.fields.title") %>
    <%= form.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= form.label :body, t("admin.gallery_entries.fields.body") %>
    <%= form.text_area :body, rows: 6 %>
  </div>

  <div class="field">
    <%= form.label :event_date, t("admin.gallery_entries.fields.event_date") %>
    <%= form.date_field :event_date %>
  </div>

  <%# Built from the photo rows, which own the photo-to-asset link. This read
      metadata["media_asset_ids"] until 572e599 moved that link onto the rows --
      nothing writes that array any more, so for any album created since it was
      permanently empty and the block was reading a dead concept. The url here
      is the photo's own, which is what apply_uploaded_assets matches on. %>
  <% asset_payload = gallery_entry.photos.filter_map do |photo|
      { id: photo.media_asset_id, url: photo.url } if photo.media_asset_id
    end %>

  <div class="field">
    <label><%= t("admin.gallery_entries.fields.upload_media") %></label>
    <div class="media-upload media-upload--gallery"
      data-media-upload
      data-media-upload-context="gallery"
      data-media-upload-append="#gallery-photo-urls"
      data-media-upload-assets="#gallery-uploaded-assets">
      <div class="media-upload__controls">
        <select data-media-upload-kind class="media-upload__select">
          <option value="image"><%= t("admin.gallery_entries.fields.media_image") %></option>
          <option value="video"><%= t("admin.gallery_entries.fields.media_video") %></option>
        </select>
        <input type="file" accept="image/*,video/*" data-media-upload-file class="media-upload__file-input">
        <button type="button" class="btn btn-secondary" data-media-upload-button>
          <%= t("admin.media_uploads.actions.upload") %>
        </button>
        <span class="media-upload__status" data-media-upload-status></span>
      </div>
      <p class="muted"><%= t("admin.gallery_entries.hints.upload_media") %></p>
    </div>
    <%= hidden_field_tag "temple_gallery_entry[uploaded_assets_payload]",
      asset_payload.to_json,
      id: "gallery-uploaded-assets" %>
  </div>

  <% if gallery_entry.persisted? && gallery_entry.photos.any? { |photo| !photo.archived? } %>
    <%# The id is the redirect target for the photo controls below. Without it
        every move landed the admin at the top of the form, scrolling back down
        to the grid after each one. %>
    <div class="field" id="album-photos">
      <label><%= t("admin.gallery_entries.fields.current_photos") %></label>
      <%# Submit buttons carrying a named param, not nested forms -- the photo
          list sits inside the entry form and forms do not nest. Same shape as
          the hero image Remove control in admin/temples/_hero_image_slot. %>
      <ul class="gallery-photo-grid">
        <% live_photos = gallery_entry.photos.reject(&:archived?) %>
        <% live_photos.each_with_index do |photo, index| %>
          <li class="gallery-photo">
            <img src="<%= photo.url %>" alt="" class="gallery-photo__image" loading="lazy">
            <div class="gallery-photo__actions">
              <%# Order is what a visitor sees, so it is edited here rather than
                  by rewriting the URL textarea. Disabled at the ends because a
                  control that silently does nothing is worse than one that
                  says it cannot. %>
              <button type="submit"
                name="photo_move_up[<%= photo.id %>]"
                value="1"
                class="btn btn-secondary gallery-photo__move"
                aria-label="<%= t("admin.gallery_entries.actions.move_up") %>"
                <%= "disabled" if index.zero? %>
                formnovalidate>&uarr;</button>
              <button type="submit"
                name="photo_move_down[<%= photo.id %>]"
                value="1"
                class="btn btn-secondary gallery-photo__move"
                aria-label="<%= t("admin.gallery_entries.actions.move_down") %>"
                <%= "disabled" if index == live_photos.size - 1 %>
                formnovalidate>&darr;</button>
              <button type="submit"
                name="photo_remove[<%= photo.id %>]"
                value="1"
                class="btn btn-secondary gallery-photo__remove"
                formnovalidate>
                <%= t("admin.gallery_entries.actions.remove_photo") %>
              </button>
            </div>
          </li>
        <% end %>
      </ul>
      <p class="muted"><%= t("admin.gallery_entries.hints.reorder") %></p>
      <p class="muted"><%= t("admin.gallery_entries.hints.remove_photo") %></p>
    </div>
  <% end %>

  <% archived_photos = gallery_entry.persisted? ? gallery_entry.photos.select(&:archived?) : [] %>
  <% if archived_photos.any? %>
    <details class="field gallery-archived" id="album-archived">
      <%# Collapsed by default: an archived photo is out of the way, not gone,
          and the shelf should not compete with the live set above it. %>
      <summary><%= t("admin.gallery_entries.fields.archived_photos", count: archived_photos.size) %></summary>
      <ul class="gallery-photo-grid gallery-photo-grid--archived">
        <% archived_photos.each do |photo| %>
          <li class="gallery-photo">
            <img src="<%= photo.url %>" alt="" class="gallery-photo__image" loading="lazy">
            <div class="gallery-photo__actions">
              <button type="submit"
                name="photo_restore[<%= photo.id %>]"
                value="1"
                class="btn btn-secondary gallery-photo__restore"
                formnovalidate>
                <%= t("admin.gallery_entries.actions.restore_photo") %>
              </button>
              <%# Deleting is offered only here, never beside a live photo. The
                  archive is the gate: an operator has to have taken the photo
                  down, and seen it stay down, before the file can be reclaimed.
                  Unlike everything else on this page, this one cannot be undone.

                  data-confirm is bound by shared/modal_script for form submits,
                  including the submitter's own attribute -- so the dialog does
                  appear. An earlier version of this comment claimed otherwise
                  and dropped the attribute; that was wrong, and the check that
                  found it was grepping the layout for <script> without following
                  the partials it renders. %>
              <button type="submit"
                name="photo_destroy[<%= photo.id %>]"
                value="1"
                class="btn btn-danger gallery-photo__destroy"
                data-confirm="<%= t("admin.gallery_entries.hints.destroy_photo") %>"
                formnovalidate>
                <%= t("admin.gallery_entries.actions.destroy_photo") %>
              </button>
            </div>
          </li>
        <% end %>
      </ul>
      <p class="muted"><%= t("admin.gallery_entries.hints.restore_photo") %></p>
      <p class="muted"><%= t("admin.gallery_entries.hints.destroy_photo") %></p>
    </details>
  <% end %>

  <div class="field">
    <%= form.label :photo_urls_raw, t("admin.gallery_entries.fields.photo_urls") %>
    <%= text_area_tag "temple_gallery_entry[photo_urls_raw]",
      gallery_entry.photo_urls.join("\n"),
      rows: 4,
      class: "form-control",
      id: "gallery-photo-urls" %>
    <p class="muted"><%= t("admin.gallery_entries.hints.photo_urls") %></p>
  </div>

  <div class="form-actions form-actions--centered">
    <%= form.submit t("admin.gallery_entries.actions.save"), class: "btn btn-primary" %>
    <%= link_to t("admin.gallery_entries.actions.cancel"), admin_gallery_entries_path, class: "btn btn-secondary" %>
  </div>
<% end %>

<%= render "admin/shared/media_upload_script" %>
