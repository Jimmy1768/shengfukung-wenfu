# System artifacts
.DS_Store
Thumbs.db
tmp/

# Environment & secrets (keep templates)
/.env*
!.env*.example
!.env*.erb
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node dependencies, at any depth. This was three per-directory patterns
# (vue/, expo/, mobile/) and the repository root was the gap they left --
# 131 files, 16MB, including darwin-arm64 native binaries, were committed
# and reached the Linux droplet. One pattern cannot have a gap.
node_modules/

# Vue (marketing) build outputs
vue/dist/

# Expo / mobile artifacts
expo/.expo/
expo/.expo-shared/
expo/android/
expo/ios/
expo/web-build/
expo/dist/
mobile/.expo/
mobile/.expo-shared/
mobile/android/
mobile/ios/
mobile/web-build/
mobile/dist/
*.apk
*.aab
*.ipa

