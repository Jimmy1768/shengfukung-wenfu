rails/.bundle/
rails/log/*
!/rails/log/.keep
rails/tmp/*
!/rails/tmp/.keep
rails/tmp/pids/*
!/rails/tmp/pids/
!/rails/tmp/pids/.keep
rails/tmp/storage/*
!/rails/tmp/storage/
!/rails/tmp/storage/.keep
rails/storage/*
!/rails/storage/.keep
rails/config/master.key
rails/public/backend/assets/*.map

