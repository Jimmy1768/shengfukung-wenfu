# ops/systemd/shengfukung-demo-staging-puma.service
#
# Systemd unit for the staging Puma web server. Mirrors
# shengfukung-demo-puma.service except for the working directory (a
# separate checkout, not shared with production) and three explicit
# runtime overrides (RAILS_ENV, PUMA_PORT, PGDATABASE).
#
# Deliberately shares production's own env file -- no separate staging
# env file exists (Director's call: staging protects the production
# server, it doesn't multiply file-management surface). SECRET_KEY_BASE
# and JWT_SECRET_KEY are reused as-is from that file, which is why the
# override list below is exactly the three values that must differ for
# isolation and nothing more.
#
# S3_OBJECT_PREFIX=staging keeps staging's uploads out of production's
# namespace. Both share this bucket and this env file, so without it every
# staging upload lands beside production's and a reclamation sweep in
# either would see the other's files as orphans -- their databases are
# separate. Scheme: dev -> "dev", staging -> "staging", production -> none.
#
# The override MUST be done as a command prefix inside ExecStart, not as
# a separate Environment= directive: per systemd.exec(7)'s documented
# "Environment Variables in Spawned Processes" precedence order,
# EnvironmentFile= is resolved AFTER Environment=, so EnvironmentFile=
# always wins regardless of which one appears later in this unit file.
# An Environment=PGDATABASE=... line here would have been silently
# overridden BACK to production's templemate_data by EnvironmentFile= --
# verified directly against `man systemd.exec` on this host before
# writing this, not assumed.
#
# Staging runs from its own clone on its own branch (main), independent
# of the production checkout (release/current) at
# /home/jimmy1768_user/Projects/shengfukung-demo -- so promoting main
# to release/current can never be blocked by, or interfere with, a
# staging deploy in progress.

[Unit]
Description=竹南鎮聖福宮 Puma HTTP Server (Staging)
After=network.target

[Service]
Type=simple
User=jimmy1768_user
WorkingDirectory=/home/jimmy1768_user/Projects/shengfukung-demo-staging/rails
EnvironmentFile=/etc/default/shengfukung-demo-env
# The instance file is named by the checkout path, so this deployment cannot
# read the other's: which code and which data go together is a filesystem fact,
# not a list entry. It is listed SECOND because where two EnvironmentFile= lines
# set the same variable the later one wins (systemd.exec(7)), which is what makes
# the migration safe in stages -- it already wins before anything is removed from
# the shared file. There is no `-` prefix: `EnvironmentFile=-/path` skips a
# missing file silently and throws away that whole property.
EnvironmentFile=/home/jimmy1768_user/Projects/shengfukung-demo-staging/instance.env
ExecStart=/usr/bin/bash -lc "/home/jimmy1768_user/.rbenv/bin/rbenv exec bundle exec puma -C config/puma.rb"
Restart=always

[Install]
WantedBy=multi-user.target
