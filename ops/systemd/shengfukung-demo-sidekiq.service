# ops/systemd/shengfukung-demo-sidekiq.service
#
# Systemd unit template for the Sidekiq worker process.
#
# NOTE:
# - Match the slug referenced in `AppConstants::Project` so service names stay predictable.

[Unit]
Description=竹南鎮聖福宮 Sidekiq
After=network.target

[Service]
Type=simple
User=jimmy1768_user
WorkingDirectory=/home/jimmy1768_user/Projects/shengfukung-demo/rails
EnvironmentFile=/etc/default/shengfukung-demo-env
# The instance file is named by the checkout path, so this deployment cannot
# read the other's: which code and which data go together is a filesystem fact,
# not a list entry. It is listed SECOND because where two EnvironmentFile= lines
# set the same variable the later one wins (systemd.exec(7)), which is what makes
# the migration safe in stages -- it already wins before anything is removed from
# the shared file. There is no `-` prefix: `EnvironmentFile=-/path` skips a
# missing file silently and throws away that whole property.
EnvironmentFile=/home/jimmy1768_user/Projects/shengfukung-demo/instance.env
ExecStart=/usr/bin/bash -lc "/home/jimmy1768_user/.rbenv/bin/rbenv exec bundle exec sidekiq -r . -C config/sidekiq.yml"
Restart=always

[Install]
WantedBy=multi-user.target
