# EXAMPLE ONLY -- this file is not read by anything.
#
# Copy it to the production checkout as `instance.env` (that name is gitignored,
# this one is not):
#
#     cp ops/env/template.instance.production.env ~/Projects/shengfukung-wenfu/instance.env
#
# It holds the values that differ per deployment, and nothing else. Everything
# identical across deployments stays in the shared systemd EnvironmentFile at
# /etc/default/shengfukung-wenfu-env. No variable is set in both files: there is
# no precedence question, because nothing is ever overridden.
#
# That is the whole point. Previously these five lived in the shared file and
# staging corrected three of them with a systemd ExecStart prefix, so losing the
# prefix silently gave staging production's database. With the partition, a
# forgotten value is absent rather than production's -- and absent cannot serve
# traffic, because config/initializers/deployment_identity.rb refuses to boot.
#
# Values below were read live from the host on 2026-09-13. S3_OBJECT_PREFIX is
# `prod`, not blank: blank would relocate every production S3 object path.

RAILS_ENV=production
RACK_ENV=production
PUMA_PORT=4003
PGDATABASE=templemate_data
S3_OBJECT_PREFIX=prod
