# EXAMPLE ONLY -- this file is not read by anything.
#
# Copy it to the staging checkout as `instance.env` (that name is gitignored,
# this one is not):
#
#     cp ops/env/template.instance.staging.env ~/Projects/shengfukung-demo-staging/instance.env
#
# See template.instance.production.env for why this file exists. The same five
# keys appear in both files with different values, and in neither case does any
# key here also appear in the shared /etc/default/shengfukung-demo-env.
#
# Two of these are changes in behaviour rather than transcriptions of what the
# host runs today, and both are deliberate:
#
#   RACK_ENV=staging        staging currently runs RACK_ENV=production, because
#                           RACK_ENV sat in the shared file and was not among the
#                           three values staging overrode. Its Rails said staging
#                           while its Rack said production.
#
#   S3_OBJECT_PREFIX=staging  staging currently writes under production's `prod`
#                           prefix, for the same reason. Objects already written
#                           under `prod` stay where they are.
#
# RAILS_ENV=staging is correct and intended: config/environments/staging.rb is a
# single require of production.rb, so staging behaves identically to production
# while Rails.env stays honest for logs, error reports and config/puma.rb.

RAILS_ENV=staging
RACK_ENV=staging
PUMA_PORT=4002
PGDATABASE=templemate_data_staging
S3_OBJECT_PREFIX=staging
