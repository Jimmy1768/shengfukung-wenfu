# Copy to .env.development (gitignored) and fill in. Nothing here is required
# for the database: config/database.yml derives templemate_dev and
# templemate_test from databaseName in project.json, and username falls back to the
# OS user, so a fresh clone connects with no configuration.
#
# Set these only to point somewhere else:
#   PGDATABASE=        # override the derived development database
#   PGDATABASE_TEST=   # override the derived test database
#   PGUSER=            # override the OS user (production uses templemate_admin)
#   PGHOST=            # defaults to localhost
#   PGPORT=            # defaults to 5432

# Required for the app to boot in development:
JWT_SECRET_KEY=

# Optional integrations:
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
GOOGLE_MAPS_API_KEY=
DEV_EMAIL=
DEV_APP_NOTIFICATION_EMAIL=
